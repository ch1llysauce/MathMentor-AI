{
  "expo": {
    "name": "MathMentor AI",
    "slug": "mathmentor-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/MathMentorAILogoIcon.png",
    "scheme": "mathmentor",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/MathMentorAILogoIcon.png",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/MathMentorAILogoIcon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mathmentor.mobile",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/MathMentorAILogo.png",
          "imageWidth": 200
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4911d4c5-8871-4d37-b1ae-cdbc98475789"
      }
    },
    "owner": "ch1llysauce"
  }
}
